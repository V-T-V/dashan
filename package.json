{
  "name": "dashan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大善系统 —— 善恶由我定，你是大好人。无论你做什么选择都把你夸成大好人的对话/选项交互系统。",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx server/index.ts\"",
    "server": "tsx server/index.ts",
    "cli": "tsx cli/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,css,md}\"",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch --import tsx \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
