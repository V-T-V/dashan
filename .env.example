# ============================================================
# 大善系统 配置（OpenAI 兼容接口）
# 复制本文件为 .env 并填入真实值即可启用真实 LLM。
# 不配置 API Key 时，系统自动回退到内置预设情境库，无需联网/付费即可开玩。
# ============================================================

# LLM 服务地址（OpenAI 兼容的 chat completions 端点）
# 智谱 GLM:
#   KINDNESS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek:
#   KINDNESS_LLM_BASE_URL=https://api.deepseek.com/v1
# OpenAI:
#   KINDNESS_LLM_BASE_URL=https://api.openai.com/v1
KINDNESS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key（留空则使用预设情境库回退）
KINDNESS_LLM_API_KEY=

# 模型名（需与上方服务匹配）
# GLM: glm-4-plus / glm-4-flash ...
# DeepSeek: deepseek-chat / deepseek-reasoner
# OpenAI: gpt-4o-mini / gpt-4o ...
KINDNESS_LLM_MODEL=glm-4-flash

# 可选：LLM 请求失败重试次数（针对 429/5xx/网络错误，指数退避）
KINDNESS_LLM_RETRIES=3

# 可选：单次 LLM 请求超时（毫秒），超时自动重试，防止永久卡死
KINDNESS_LLM_TIMEOUT_MS=30000

# 可选：生成温度（越低 JSON 越稳定；夸赞的创造性由 prompt 语气轮换驱动）
KINDNESS_LLM_TEMPERATURE=0.3

# 可选：强制 JSON 输出（response_format），1 开启，0 关闭（兼容不支持的老端点）
KINDNESS_LLM_JSON_MODE=1

# 可选：网页版本地代理端口（CLI 不使用此端口）
KINDNESS_SERVER_PORT=5180

# 可选：CORS 允许的来源（默认仅本地 vite 源；多个用逗号分隔；生产部署时改为你的域名）
KINDNESS_CORS_ORIGIN=http://localhost:5173

# 可选：请求体大小上限（字节），防止滥用
KINDNESS_MAX_BODY_BYTES=65536
